# ==============================================================================
# SEGURIDAD, SECRETOS Y CREDENCIALES (CRÍTICO)
# ==============================================================================
# Variables de entorno y secretos
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
# Permitir compartir plantillas de ejemplo seguras
!.env.example
!.env.template

# Claves privadas, certificados y SSH
*.pem
*.key
*.pkcs12
*.pfx
*.p12
*.crt
*.csr
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub

# Tokens, credenciales y autenticación
credentials.json
client_secret*.json
token.json
auth.json
*.token
secrets.yaml
secrets.yml
*.kdbx

# Historial de terminales y shells
.bash_history
.zsh_history
.node_repl_history
.python_history

# ==============================================================================
# LATEX / DOCUMENTACIÓN (Protocolo, TT1, TT2)
# ==============================================================================
*.aux
*.bbl
*.blg
*.fls
*.fdb_latexmk
*.log
*.lof
*.lot
*.out
*.toc
*.synctex.gz
*.synctex
*.bcf
*.run.xml
*.nav
*.snm
*.vrb
*.idx
*.ilg
*.ind
*.glo
*.gls

# Artículos científicos y literatura de referencia (PDFs pesados)
Documentacion/Articulos/*
!Documentacion/Articulos/README.md
!Documentacion/Articulos/catalogo_articulos.md

# ==============================================================================
# ROS 2, COLCON & COMPILACIÓN (C / C++)
# ==============================================================================
build/
install/
log/
.colcon/
compile_commands.json
*.o
*.obj
*.so
!**/third_party/onnxruntime/lib/*.so*
*.dylib
*.a
*.exe

# Gazebo / Ignition Simulation Cache
.ignition/
.gz/

# ==============================================================================
# DATASETS, ROSBAGS Y ARCHIVOS PESADOS
# ==============================================================================
# Grabaciones de ROS 2 bags (archivos y metadatos)
*.db3
*.mcap
*_bag/
rosbag2_*/

# Comprimidos pesados
*.tar.gz
*.tar.xz
*.zip
*.rar
*.7z

# ==============================================================================
# MACHINE LEARNING, ENTRENAMIENTOS Y CHECKPOINTS
# ==============================================================================
# Archivos temporales de exportación y cuantización ONNX
temp_*.onnx
*.tmp
*.temp

# Telemetría y logs de entrenamiento
runs/
tensorboard/
.wandb/
.ipynb_checkpoints/

# Checkpoints de entrenamiento (descomentar si no deseas versionar modelos pesados):
# *.pth
# *.pt
# *.ckpt
# *.pkl

# Permitir explícitamente modelos ONNX para inferencia / despliegue
!*.onnx
!*.onnx.data

# Datasets muy pesados generados (>100MB superan el límite de GitHub)
*.csv
dataset_ur3_*/

# ==============================================================================
# PYTHON & ENTORNOS VIRTUALES
# ==============================================================================
# Entornos virtuales
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Bytecode y caché de Python
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Distribución y empaquetado de Python
dist/
*.egg-info/
.eggs/

# ==============================================================================
# SISTEMAS OPERATIVOS
# ==============================================================================
# Linux
*~

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ==============================================================================
# IDES Y EDITORES (Aplica a raíz y subdirectorios como ros2_ws/)
# ==============================================================================
# VS Code: ignorar temporales, permitir configuración de equipo
**/.vscode/*
!**/.vscode/settings.json
!**/.vscode/tasks.json
!**/.vscode/launch.json
!**/.vscode/extensions.json
!**/.vscode/c_cpp_properties.json
*.code-workspace

# Bases de datos de IntelliSense C/C++ y bases de datos locales
*.vc.db
*.db
*.db-shm
*.db-wal

# JetBrains (PyCharm, CLion, etc.)
.idea/
*.iws
*.iml

# Vim / Nano / Emacs
*.swp
*.swo
*~
.#*
